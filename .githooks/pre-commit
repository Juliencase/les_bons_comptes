#!/bin/sh
# verifie les secrets et le style avant de valider le commit
# active-toi une fois par clone: git config core.hooksPath .githooks

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact -v || exit 1
fi

if [ -x node_modules/.bin/eslint ] && [ -x node_modules/.bin/prettier ]; then
  js_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.js' '*.jsx' '*.ts' '*.tsx')
  if [ -n "$js_files" ]; then
    node_modules/.bin/prettier --write $js_files
    node_modules/.bin/eslint --fix $js_files
    git add $js_files
    node_modules/.bin/eslint $js_files || exit 1
  fi
fi
